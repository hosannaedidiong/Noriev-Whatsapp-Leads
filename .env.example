# Meta WhatsApp Cloud API — from developers.facebook.com/apps/<app-id>/whatsapp-business/wa-dev-console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose — must match what you type into the Meta webhook config
WHATSAPP_VERIFY_TOKEN=

# Where an agent gets notified of a qualified lead (a WhatsApp number in E.164, no +)
AGENT_NOTIFY_WA_ID=

PORT=3000
